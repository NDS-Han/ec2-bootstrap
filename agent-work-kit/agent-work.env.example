# agent-work.env — local, git-excluded configuration for agent-work-kit.
# install.sh renders the @@…@@ placeholders. If copying manually, replace them yourself.
# List values are space-separated; paths in list values must not contain spaces.

PROJECT_NAME=@@PROJECT_NAME_SH@@
REPO_DIR=@@REPO_DIR_SH@@
WORK_DIR=@@WORK_DIR_SH@@

# Branch policy. PROTECTED_BRANCHES are branches agents must never commit/merge/rebase onto.
BASE_BRANCH=@@BASE_BRANCH_SH@@
PROTECTED_BRANCHES=@@PROTECTED_BRANCHES_SH@@

# Project operations. DEPLOY_CMD may be a command name or path; matching commands are blocked for agents.
DEPLOY_CMD=@@DEPLOY_CMD_SH@@
SERVICES=@@SERVICES_SH@@
PROTECTED_FILES=@@PROTECTED_FILES_SH@@
HOT_PATH_DIRS=@@HOT_PATH_DIRS_SH@@
COMMIT_STYLE=@@COMMIT_STYLE_SH@@

# Devin CLI implementation defaults. Never rely on the CLI's machine-wide default model.
DEVIN_BIN=@@DEVIN_BIN_SH@@
DEVIN_MODEL=@@DEVIN_MODEL_SH@@
DEVIN_PERMISSION_MODE=@@DEVIN_PERMISSION_MODE_SH@@
DEVIN_VERBOSITY=@@DEVIN_VERBOSITY_SH@@
DEVIN_CONFIG=@@DEVIN_CONFIG_SH@@

# Kiro CLI defaults. KIRO_ALLOW_MAX=1 is a per-run explicit approval gate, not a standing recommendation.
KIRO_BIN=@@KIRO_BIN_SH@@
KIRO_AGENT=@@KIRO_AGENT_SH@@
KIRO_AGENT_MAX=@@KIRO_AGENT_MAX_SH@@
KIRO_EFFORT=@@KIRO_EFFORT_SH@@
KIRO_ALLOW_MAX=@@KIRO_ALLOW_MAX_SH@@

# Queue behavior.
MAX_CONCURRENT=@@MAX_CONCURRENT_SH@@
MAX_ROUNDS=@@MAX_ROUNDS_SH@@
QUEUE_TASKS=@@QUEUE_TASKS_SH@@
QUEUE_START_STAGGER_SEC=@@QUEUE_START_STAGGER_SEC_SH@@
DEPENDENCY_POLL_SEC=@@DEPENDENCY_POLL_SEC_SH@@

# Review behavior. AUTO_XREVIEW=1 starts a Kiro read-only review after DONE.
# CLAUDE_REVIEW_TASKS is a space-separated list of security/cost/hot-path tasks reserved for Claude review.
AUTO_XREVIEW=@@AUTO_XREVIEW_SH@@
REVIEW_TIMEOUT_SEC=@@REVIEW_TIMEOUT_SEC_SH@@
CLAUDE_REVIEW_TASKS=@@CLAUDE_REVIEW_TASKS_SH@@

# Reporting and workspace behavior.
REPORT_LANG=@@REPORT_LANG_SH@@
ALLOWED_RM_ROOTS=@@ALLOWED_RM_ROOTS_SH@@

# Optional symlink imports into each task worktree, as src[:dst] pairs relative to REPO_DIR/worktree.
# Example: WORKTREE_LINKS="app/.venv app/ui/node_modules:app/ui/node_modules"
WORKTREE_LINKS=@@WORKTREE_LINKS_SH@@
